# Copy this file to .env and fill in values before running locally.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/cheery-scrapio

# Docker MongoDB credentials (required when using docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme

# Optional: when set, POST /scrape requires header `x-scrape-token: <value>`
# and the in-app Refresh News buttons are hidden. Leave unset for local dev.
# SCRAPE_SECRET=

# Left lane (Guardian API key)
GUARDIAN_API_KEY=

# Scrape source URLs
SCRAPE_URL_RIGHT=http://www.freerepublic.com/tag/breaking-news/index?tab=articles
SCRAPE_URL_CENTER=http://www.bbc.com/news/world/us_and_canada

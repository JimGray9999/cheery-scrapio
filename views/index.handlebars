<div class="columns">

  <!-- ── Left Column ─────────────────────────────── -->
  <section class="col col-left">
    <div class="col-header">
      <span class="col-label">Left</span>
      <span class="col-source">Democratic Underground</span>
    </div>
    <div class="col-articles">

      {{#each leftArticles}}
        {{> articleCard}}
      {{/each}}

      {{#if leftCursor}}
        <button class="btn-load-more" data-filter="left" data-cursor="{{leftCursor}}">Load more</button>
      {{/if}}

      <div class="empty-state">
        <p>No left articles yet.</p>
        <form action="/scrape" method="post" class="inline-form">
          <button type="submit" class="btn-link">Scrape now &rarr;</button>
        </form>
      </div>

    </div>
  </section>

  <!-- ── Center Column ───────────────────────────── -->
  <section class="col col-center">
    <div class="col-header">
      <span class="col-label">Center</span>
      <span class="col-source">BBC News</span>
    </div>
    <div class="col-articles">

      {{#each centerArticles}}
        {{> articleCard}}
      {{/each}}

      {{#if centerCursor}}
        <button class="btn-load-more" data-filter="center" data-cursor="{{centerCursor}}">Load more</button>
      {{/if}}

      <div class="empty-state">
        <p>No center articles yet.</p>
        <form action="/scrape" method="post" class="inline-form">
          <button type="submit" class="btn-link">Scrape now &rarr;</button>
        </form>
      </div>

    </div>
  </section>

  <!-- ── Right Column ────────────────────────────── -->
  <section class="col col-right">
    <div class="col-header">
      <span class="col-label">Right</span>
      <span class="col-source">Free Republic</span>
    </div>
    <div class="col-articles">

      {{#each rightArticles}}
        {{> articleCard}}
      {{/each}}

      {{#if rightCursor}}
        <button class="btn-load-more" data-filter="right" data-cursor="{{rightCursor}}">Load more</button>
      {{/if}}

      <div class="empty-state">
        <p>No right articles yet.</p>
        <form action="/scrape" method="post" class="inline-form">
          <button type="submit" class="btn-link">Scrape now &rarr;</button>
        </form>
      </div>

    </div>
  </section>

</div>

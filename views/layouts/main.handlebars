<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Balance — Left · Center · Right</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>

    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-top">
          <a href="/all" class="masthead-logo">Balance</a>
          <nav class="masthead-nav">
            <a href="/all" class="nav-link" data-path="/all">All</a>
            <a href="/left" class="nav-link" data-path="/left">Left</a>
            <a href="/right" class="nav-link" data-path="/right">Right</a>
            <form action="/scrape" method="post" class="inline-form">
              <button type="submit" class="nav-scrape btn-link">Refresh News</button>
            </form>
          </nav>
        </div>
        <div class="masthead-rule"></div>
        <p class="masthead-tagline">Left &middot; Center &middot; Right &mdash; All in one place</p>
      </div>
    </header>

    <main>
      {{{body}}}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col">
          <h4>Balance</h4>
          <p>Read news from multiple perspectives in one place. Scrape the latest articles and form
            your own view.</p>
        </div>
        <div class="footer-col">
          <h4>Sources</h4>
          <ul>
            <li><a
                href="https://www.democraticunderground.com"
                target="_blank"
                rel="noopener noreferrer"
              >Democratic Underground</a></li>
            <li><a href="https://www.bbc.com/news" target="_blank" rel="noopener noreferrer">BBC
                News</a></li>
            <li><a
                href="https://www.freerepublic.com"
                target="_blank"
                rel="noopener noreferrer"
              >Free Republic</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Fact Check</h4>
          <ul>
            <li><a
                href="http://www.factcheck.org/"
                target="_blank"
                rel="noopener noreferrer"
              >FactCheck.org</a></li>
            <li><a
                href="http://www.snopes.com/"
                target="_blank"
                rel="noopener noreferrer"
              >Snopes</a></li>
            <li><a
                href="https://www.allsides.com/"
                target="_blank"
                rel="noopener noreferrer"
              >AllSides</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024 Balance &mdash; A news aggregator project</p>
      </div>
    </footer>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script src="/js/app.js"></script>
  </body>
</html>